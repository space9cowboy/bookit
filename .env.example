# BookIt — variables d'environnement
# Copier en .env à la racine : cp .env.example .env
# Toutes ont une valeur par défaut dans docker-compose.yml : ce fichier est optionnel.

# --- Ports exposés sur la machine hôte
# Front : http://localhost:8080
WEB_PORT=8080
# API directe : http://localhost:3000/api
API_PORT=3000
# PostgreSQL (5433 pour éviter un conflit avec un Postgres local)
DB_PORT=5433

# --- Base de données
POSTGRES_USER=bookit
POSTGRES_PASSWORD=bookit
POSTGRES_DB=bookit

# --- API
# test        : active POST /api/test/reset (valeur par défaut, l'app est une cible de test)
# development : route de reset absente (404)
# production  : idem development
NODE_ENV=test
# Secret de signature des JWT (16 caractères minimum)
JWT_SECRET=bookit-local-secret-change-me
# Durée de validité du token en secondes (3600 = 1 h). Réduire pour tester l'expiration.
JWT_EXPIRES_IN_SECONDS=3600

# --- Bugs injectables (vide = aucun bug). Plusieurs bugs : séparés par des virgules.
# API (pris en compte au redémarrage : docker compose up -d api) :
#   OVERLAP, DURATION, CAPACITY, PAST, CANCEL_DELAY, AUTH403, STATUS_CODE, SLOW
BUG=
# Front (figé au build : docker compose up -d --build web) :
#   A11Y, UI_TOTAL
VITE_BUG=
